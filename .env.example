# Synthetic local-only defaults. Do not place production credentials here.
CYTISUS_ENV=local
CYTISUS_API_ADDR=:8080
CYTISUS_SIMULATOR_ADDR=:8090
CYTISUS_SIMULATOR_ENABLED=true
CYTISUS_RWA_RPC_URL=http://anvil:8545
CYTISUS_RWA_ADMIN_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

POSTGRES_DB=cytisus
POSTGRES_USER=cytisus
POSTGRES_PASSWORD=local_only_cytisus
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://cytisus:local_only_cytisus@postgres:5432/cytisus?sslmode=disable
REDIS_URL=redis://redis:6379/0

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
CYTISUS_WEB_ORIGIN=http://localhost:3000
CYTISUS_ADMIN_WEB_ORIGIN=http://localhost:3001
MINIO_ROOT_USER=cytisus_local
MINIO_ROOT_PASSWORD=local_only_object_storage
