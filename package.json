{
  "name": "cytisus",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/admin-web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "openapi:check": "redocly lint contracts/openapi/openapi.yaml",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@redocly/cli": "2.39.0",
    "prettier": "3.6.2"
  },
  "overrides": {
    "next@16.2.10": {
      "postcss": "8.5.10"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
